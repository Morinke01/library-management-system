# Copy this file to .env and replace the placeholders with the Supabase session-pooler values.
# URL-encode reserved characters in the password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"
JWT_SECRET="replace-with-a-long-random-secret"
LIBRARIAN_EMAIL="librarian@example.com"
LIBRARIAN_PASSWORD="replace-with-a-strong-password"
